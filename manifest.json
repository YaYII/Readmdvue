{
  "manifest_version": 3,
  "name": "Markdown Reader Vue",
  "version": "2.0.0",
  "description": "基于Vue.js 3.0的现代化Markdown阅读器浏览器插件",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://kroki.io/*",
    "https://*.githubusercontent.com/*",
    "https://*.github.com/*",
    "https://*.gitlab.com/*",
    "https://*.bitbucket.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://kroki.io https://*.githubusercontent.com https://*.github.com https://*.gitlab.com https://*.bitbucket.org; connect-src 'self' https://kroki.io https://*.githubusercontent.com https://*.github.com https://*.gitlab.com https://*.bitbucket.org;"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "include_globs": [
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.md#*",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.markdown#*"
      ],
      "js": [
        "src/content/main.ts"
      ],
      "css": [
        "src/styles/apple-design-system.css",
        "src/styles/content-variables.css",
        "src/styles/enhanced-components.css",
        "src/styles/vue-toolbar.css",
        "src/styles/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Markdown Reader Vue",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/main.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*",
        "src/styles/*",
        "assets/*",
        "*.js",
        "*.css",
        "*.svg",
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.gif",
        "*.woff",
        "*.woff2",
        "*.ttf",
        "*.eot"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}